      "type": "string"
    },
    "empresa": {
      "type": "string"
    },
    "industria": {
      "type": "string"
    },
    "ciudad": {
      "type": "string"
    },
    "empleados": {
      "type": "number"
    },
    "mensaje_inicial": {
      "type": "string"
    },
    "informacion_que_falta": {
      "type": "string"
    },
    "tipo_de_caso": {
      "type": "string"
    }
  },
  "required": [
