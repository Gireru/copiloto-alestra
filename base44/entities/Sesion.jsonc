{
  "name": "Sesion",
  "type": "object",
  "properties": {
    "cliente": {
      "type": "string"
    },
    "industria": {
      "type": "string"
    },
    "empleados": {
      "type": "number"
    },
    "transcripcion": {
      "type": "string"
    },
    "productos_candidatos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    },
    "paquete_sugerido": {
      "type": [
        "string",
        "null"
      ]
    },
    "preguntas_siguientes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "respuestas_sugeridas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "datos_extraidos": {
      "type": "object"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reglas_disparadas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tipo_de_caso": {
      "type": "string"
    },
    "inventadas_bloqueadas": {
      "type": "number",
      "default": 0
    },
    "inicio": {
      "type": "string",
      "format": "date-time"
    },
    "fin": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}