{
  "name": "Propuesta",
  "type": "object",
  "properties": {
    "sesion": {
      "type": "string"
    },
    "lineas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "plazo_meses": {
      "type": "number"
    },
    "paquete": {
      "type": [
        "string",
        "null"
      ]
    },
    "subtotal_mensual": {
      "type": "number"
    },
    "descuentos": {
      "type": "number"
    },
    "desglose_descuentos": {
      "type": "object"
    },
    "descuento_total_pct": {
      "type": "number"
    },
    "descuento_extra_pct": {
      "type": "number"
    },
    "subtotal_con_descuento": {
      "type": "number"
    },
    "iva": {
      "type": "number"
    },
    "total_mensual": {
      "type": "number"
    },
    "cargos_unicos": {
      "type": "number"
    },
    "cargos_unicos_total": {
      "type": "number"
    },
    "nota_cargos_unicos": {
      "type": "string"
    },
    "requiere_autorizacion": {
      "type": "boolean"
    },
    "estado": {
      "type": "string",
      "enum": [
        "lista",
        "pendiente_autorizacion",
        "autorizada"
      ]
    },
    "mensajes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vigencia": {
      "type": "string",
      "format": "date"
    },
    "expediente_arquitecto": {
      "type": [
        "object",
        "null"
      ]
    },
    "catalogo_version": {
      "type": "string"
    },
    "catalogo_fecha": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "required": []
}